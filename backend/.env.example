# Copie este archivo como ".env" para cambiar de motor. Sin .env se usa SQLite (valor por defecto).

# --- SQLite (por defecto: demo, pruebas y caché del Gateway) ---
DATABASE_URL=sqlite:///./agro_iot.db

# --- PostgreSQL (destino de producción; levantar con: docker compose up -d) ---
# DATABASE_URL=postgresql+psycopg2://agro:agro@localhost:5432/agro

# Clave de firma del JWT: en producción debe venir de un gestor de secretos.
# JWT_SECRET=...
